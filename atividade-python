Questão 4: Verificador de Número Primo (1 a 100)
Python
def eh_primo(n):
    if n <= 1:
        return False
    for i in range(2, int(n ** 0.5) + 1):
        if n % i == 0:
            return False
    return True

# Testando de 1 a 100
for numero in range(1, 101):
    status = "é primo" if eh_primo(numero) else "não é primo"
    print(f"{numero}: {status}")
Questão 5: Inverter Letras de Cada Palavra
Python
def inverter_palavras(frase):
    palavras = frase.split()
    palavras_invertidas = [palavra[::-1] for palavra in palavras]
    return " ".join(palavras_invertidas)

texto = input("Digite uma frase: ")
resultado = inverter_palavras(texto)
print(f"Frase com palavras invertidas: {resultado}")
